NODE_ENV=production
TZ=UTC
DefaultLocale=en
APIPort=3000
DiscordToken=DISCORD_TOKEN
DiscordIntents=default
LogLevel=info
Database={"alias": {"uri": "DATABASE_URI", "engine": "mongo || redis || native-pg || native-sqlite || [OPTIONAL]", "poolSize": "0 [OPTIONAL]", "maxRetries": "3 [OPTIONAL]" }}
isSharded=true
hotReloadEnabled=false
SmtpHost=smtp.gmail.com
SmtpPort=587
SmtpUser=your_email@gmail.com
SmtpPass=your_app_password
BotName=MyBot
MainGuildName=MyGuild