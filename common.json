{   
    "__info__": {
        "__author__": "Lunedusk",
        "version": "0.1.17"
    },
    "BotName": "MyBot",
    "MainGuildName": "MyGuild",
    "ENVSettings": true,
    "DiscordToken": "DISCORD_TOKEN",
    "DiscordIntents": ["default"],
    "TZ": "UTC",
    "DefaultLocale": "en",
    "APIPort": 3000,
    "LogLevel": "info",
    "Database": {
        "alias": {
            "uri": "DATABASE_URI",
            "engine": "mongo || redis || native-pg  || native-sqlite || [OPTIONAL]",
            "poolSize": "5 [OPTIONAL]",
            "maxRetries": "3 [OPTIONAL]"
        }
    },
    "isSharded": true,
    "hotReloadEnabled": false,
    "SmtpHost": "SMTP_HOST",
    "SmtpPort": 587,
    "SmtpUser": "SMTP_USER",
    "SmtpPass": "SMTP_PASS"
}