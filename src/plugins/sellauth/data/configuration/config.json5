{
    "enabled": true,
    
    // Sellauth Credentials
    "shopId": "SELLAUTH_SHOP_ID",
    "webhookSecret": "SELLAUTH_WEBHOOK_SECRET",
    "sellauthApiKey": "SELLAUTH_API_KEY",

    // Automation Settings
    "roles": {
        "customer": "CUSTOMER_ROLE",
        "admin": "ADMIN_ROLE"
    },
    "guild": "GUILD_ID",
    "notificationChannel": "NOTIFICATION_CHANNEL",
    "reviewChannel": "REVIEW_CHANNEL",
    "features": {
        "autoDMInstructions": true
    }
}