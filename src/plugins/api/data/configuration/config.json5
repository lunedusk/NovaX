{
    // Optional; falls back to http://localhost:{APIPort}
    // publicBaseUrl: "https://api.example.com",

    cors: {
        allowedOrigins: ["http://localhost:3000"],
        allowedMethods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        allowedHeaders: ["Content-Type", "Authorization", "X-Request-ID"],
        exposedHeaders: ["X-RateLimit-Limit", "X-RateLimit-Remaining", "X-Request-ID"],
        credentials: false,
        maxAge: 600,
    },
    auth: {
        enabled: true,
        masterKeySource: "env",          // "env" | "config"
        masterKeyEnvVar: "GatewayMasterKey",
        publicPaths: [
            "/api/health",
            "/api/openapi.json",
        ],
        keys: [
            {
                key: "REPLACE_ME_WITH_A_STRONG_SECRET",
                label: "default",
                enabled: true,
                // bits: ["bot.config.view"],
            },
        ],
    },
}