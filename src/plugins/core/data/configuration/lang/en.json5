{
    layouts: {
        containerSuccess: '{ "version": 1, "components": [ { "type": "container", "accentColor": "#57F287", "children": [ { "type": "text", "content": "%%emoji_tick%% **{{title}}**" }, { "type": "separator", "spacing": "small" }, { "type": "text", "content": "INJECT_DETAILS" } ] } ] }',
        containerError: '{ "version": 1, "components": [ { "type": "container", "accentColor": "#ED4245", "children": [ { "type": "text", "content": "%%emoji_cross%% **{{title}}**" }, { "type": "separator", "spacing": "small" }, { "type": "text", "content": "INJECT_DETAILS" } ] } ] }',
        helpContainer: '{ "version": 1, "components": [ { "type": "container", "accentColor": "#5865F2", "children": [] } ] }'
    },
    commands: {
        restart: {
            description: "Completely restart the bot process.",
            reasonDescription: "Optional reason recorded in the logs",
            messages: {
                acknowledged: "%%emoji_tick%% Restart sequence accepted. The process is going down now and will be revived by the supervisor.\n\n**Triggered by:** {{user}}\n**Reason:**\n> {{reason}}",
                denied: "%%emoji_no_entry%% You need the **bot.owner** or **bot.members.ban** permission bit to restart the bot.",
                unavailable: "%%emoji_caution%% The permission subsystem is currently unavailable. Please try again shortly.",
                fatalError: "%%emoji_alert%% A fatal error occurred during the restart sequence:\n```\n{{error}}\n```"
            }
        },
        help: {
            description: "View the dynamic command directory.",
            
            homeTitle: "Command Directory",
            homeDesc: "Welcome to the central command registry. Please select a module below.\n\n**Ecosystem Status:**\n> {{emoji_menu}} **Active Modules:** {{plugins}}\n> {{emoji_command}} **Accessible Commands:** {{commands}}",
            categoryTitle: "Module: {{name}}",
            commandDetailTitle: "Command Overview",
            noCommands: "> *No accessible commands registered in this module.*",
            noArgs: "None",
            cooldownFormat: "{{limit}} use(s) per {{time}}s",
            noCooldown: "None",

            pageFooter: "Page {{current}} of {{total}}",
            pluginSelectPlaceholder: "Select a module ({{start}} - {{end}})...",
            cmdSelectPlaceholder: "Select a command to view details...",
            groupSelectPlaceholder: "Select a subcommand group...",
            
            backButton: "Back",

            emojis: {
                navLeft: "%%emoji_arrow_left%%|◀️",
                navRight: "%%emoji_arrow_right%%|▶️",
                navHome: "%%emoji_home%%|🏠",
                navBack: "%%emoji_arrow_left%%|↩️",
                menu: "%%emoji_menu%%|📖",
                command: "%%emoji_command%%|💻",
                args: "%%emoji_gear%%|⚙️",
                cooldown: "%%emoji_clock%%|⏱️"
            },

            format: {
                commandList: "> `/%s` - %s",
                argumentList: "• `%s` %s - %s",
                argumentInlineReq: "<%s>",
                argumentInlineOpt: "[%s]",
                requiredTag: "(Required)",
                optionalTag: "(Optional)",
                commandDetailHeader: "### `/%s`",
                commandDetail: "**Description:**\n> %s\n\n**Base Cooldown:**\n> %s\n\n**Usage & Arguments:**\n%s"
            }
        },
        reload: {
            description: "Core subsystem hot-reload utility.",
            configDescription: "Reload a specific configuration file.",
            langDescription: "Reload a specific language namespace.",
            emojiDescription: "Force reload the global emoji mappings.",
            pluginDescription: "Hot-reload a specific plugin instance.",
            fileDescription: "The configuration filename (without extension) or 'all'",
            namespaceDescription: "The translation namespace or 'all'",
            idDescription: "The target plugin",
            messages: {
                configSuccess: "%%emoji_tick%% Successfully synchronized **{{count}}** configuration files.\n\n{{grid}}",
                configError: "%%emoji_cross%% Failed to reload target: `{{file}}`. Check console for JSON parse errors.",
                
                langSuccess: "%%emoji_tick%% Successfully recompiled translations for **{{count}}** namespaces.\n\n{{grid}}",
                langError: "%%emoji_cross%% Failed to compile language namespace: `{{namespace}}`.",
                
                emojiSuccess: "%%emoji_tick%% Global emoji map refreshed and successfully mapped to **{{count}}** assets in memory.",
                emojiError: "%%emoji_cross%% Failed to read emoji data source.",
                
                pluginSuccess: "Successfully executed hot-reload sequence.\n\n**Manifest Identity:**\n> **Name:** {{name}}\n> **Version:** v{{version}}\n> **State:** Live\n\n**Active Modules:**\n> %%emoji_gear%% **Commands:** {{cmdCount}}\n> %%emoji_megaphone%% **Events:** {{eventCount}}\n> %%emoji_globe%% **Routes:** {{routeCount}}",
                pluginError: "%%emoji_cross%% Surgical reload failed for `{{pluginId}}`.",
                
                fatalError: "%%emoji_alert%% A fatal error occurred during execution:\n```\n{{error}}\n```"
            }
        },
        cache: {
            description: "Manage internal framework caches.",
            popDescription: "Invalidate and clear a specific memory cache pool.",
            targetDescription: "The cache registry to drop",
            messages: {
                popped: "%%emoji_tick%% Successfully purged memory pool and flushed records for **{{target}}**.",
                unknown: "%%emoji_question%% Unrecognized memory cache target: `{{target}}`.\nAvailable targets: `cross-guild`",
                fatalError: "%%emoji_alert%% A fatal error occurred while manipulating cache:\n```\n{{error}}\n```"
            }
        }
    },
    errors: {
        unauthorized: "%%emoji_no_entry%% Authentication required.",
        forbidden: "%%emoji_no_entry%% You do not have permission to perform this action.",
        sessionExpired: "%%emoji_clock%% Your session has expired. Please sign in again.",
        rotationDetected: "%%emoji_shield%% Session invalidated for security reasons. Please sign in again."
    }
}
