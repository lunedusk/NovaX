{
    layouts: {
        containerSuccess: '{ "version": 1, "components": [ { "type": "container", "accentColor": "#57F287", "children": [ { "type": "text", "content": "%%emoji_tick%% **{{title}}**" }, { "type": "separator", "spacing": "small" }, { "type": "text", "content": "INJECT_DETAILS" } ] } ] }',
        containerError: '{ "version": 1, "components": [ { "type": "container", "accentColor": "#ED4245", "children": [ { "type": "text", "content": "%%emoji_cross%% **{{title}}**" }, { "type": "separator", "spacing": "small" }, { "type": "text", "content": "INJECT_DETAILS" } ] } ] }',
        helpContainer: '{ "version": 1, "components": [ { "type": "container", "accentColor": "#5865F2", "children": [] } ] }'
    },
    commands: {
        help: {
            description: "View the dynamic command directory.",
            homeTitle: "Command Directory",
            homeDesc: "Welcome to the central command registry. Please select a module below.\n\n**Ecosystem Status:**\n> {{emoji_menu}} **Active Modules:** {{plugins}}\n> {{emoji_command}} **Accessible Commands:** {{commands}}",
            categoryTitle: "Module: {{name}}",
            commandDetailTitle: "Command Overview",
            noCommands: "> *No accessible commands registered in this module.*",
            noArgs: "None",
            cooldownFormat: "{{limit}} use(s) per {{time}}s",
            noCooldown: "None",
            pageFooter: "Page {{current}} of {{total}}",
            pluginSelectPlaceholder: "Select a module ({{start}} - {{end}})...",
            cmdSelectPlaceholder: "Select a command to view details...",
            groupSelectPlaceholder: "Select a subcommand group...",
            backButton: "Back",
            emojis: {
                navLeft: "%%emoji_arrow_left%%|◀️",
                navRight: "%%emoji_arrow_right%%|▶️",
                navHome: "%%emoji_home%%|🏠",
                navBack: "%%emoji_arrow_left%%|↩️",
                menu: "%%emoji_menu%%|📖",
                command: "%%emoji_command%%|💻",
                args: "%%emoji_gear%%|⚙️",
                cooldown: "%%emoji_clock%%|⏱️"
            },
            format: {
                commandList: "> `/%s` - %s",
                argumentList: "• `%s` %s - %s",
                argumentInlineReq: "<%s>",
                argumentInlineOpt: "[%s]",
                requiredTag: "(Required)",
                optionalTag: "(Optional)",
                commandDetailHeader: "### `/%s`",
                commandDetail: "**Description:**\n> %s\n\n**Base Cooldown:**\n> %s\n\n**Usage & Arguments:**\n%s"
            }
        },
        admin: {
            description: "Bot owner administration (restart, reload, cache, guild gates).",
            titles: {
                access: "Access",
                system: "System Execution",
                restart: "System Restart",
                config: "Configuration",
                lang: "Language Cache",
                emoji: "Emoji Registry",
                plugin: "Plugin Ecosystem",
                cache: "Cache Manager",
                gate: "Guild Gate"
            },
            messages: {
                denied: "%%emoji_no_entry%% Bot owner only (BotOwnerIds / bot.owner).",
                unavailable: "%%emoji_caution%% Permission subsystem unavailable.",
                fatalError: "%%emoji_alert%% Fatal error:\n```\n{{error}}\n```",
                gated: "%%emoji_no_entry%% This feature is disabled in this server by the bot owner."
            },
            restart: {
                description: "Restart the bot process.",
                reasonDescription: "Optional reason for logs",
                acknowledged: "%%emoji_tick%% Restart accepted.\n**By:** {{user}}\n**Reason:** {{reason}}"
            },
            reload: {
                configDescription: "Reload configuration file(s).",
                langDescription: "Reload language namespace(s).",
                emojiDescription: "Reload emoji map.",
                pluginDescription: "Hot-reload a plugin.",
                fileDescription: "Config name or all",
                namespaceDescription: "Namespace or all",
                idDescription: "Plugin id",
                configSuccess: "%%emoji_tick%% Reloaded **{{count}}** configs.\n{{grid}}",
                configError: "%%emoji_cross%% Failed to reload `{{file}}`.",
                langSuccess: "%%emoji_tick%% Reloaded **{{count}}** namespaces.\n{{grid}}",
                langError: "%%emoji_cross%% Failed language `{{namespace}}`.",
                emojiSuccess: "%%emoji_tick%% Emoji map refreshed (**{{count}}**).",
                emojiError: "%%emoji_cross%% Emoji reload failed.",
                pluginSuccess: "%%emoji_tick%% Reloaded **{{name}}** v{{version}}.\n> %%emoji_gear%% Commands: {{cmdCount}}\n> %%emoji_megaphone%% Events: {{eventCount}}\n> %%emoji_globe%% Routes: {{routeCount}}",
                pluginError: "%%emoji_cross%% Reload failed for `{{pluginId}}`."
            },
            cache: {
                popDescription: "Clear a memory cache pool.",
                targetDescription: "Cache name",
                popped: "%%emoji_tick%% Purged **{{target}}**.",
                unknown: "%%emoji_question%% Unknown cache `{{target}}`."
            },
            gate: {
                guildBlockDescription: "Block the entire bot in a guild.",
                guildUnblockDescription: "Unblock a guild.",
                guildListDescription: "List guild total bans.",
                pluginBlockDescription: "Block one plugin in a guild.",
                pluginUnblockDescription: "Unblock one plugin in a guild.",
                pluginListDescription: "List plugin bans.",
                guildIdDescription: "Guild snowflake (default: current)",
                pluginIdDescription: "Plugin id",
                reasonDescription: "Optional reason",
                notReady: "%%emoji_caution%% Guild gate store is not ready.",
                needGuild: "%%emoji_caution%% Provide guild id or run inside a server.",
                guildBlocked: "%%emoji_tick%% Guild `{{guild}}` blocked.\nReason: {{reason}}",
                guildUnblocked: "%%emoji_tick%% Guild `{{guild}}` unblocked.",
                guildNotBlocked: "%%emoji_question%% Guild `{{guild}}` was not blocked.",
                pluginBlocked: "%%emoji_tick%% Plugin `{{plugin}}` blocked in `{{guild}}`.\nReason: {{reason}}",
                pluginUnblocked: "%%emoji_tick%% Plugin `{{plugin}}` unblocked in `{{guild}}`.",
                pluginNotBlocked: "%%emoji_question%% Plugin `{{plugin}}` was not blocked in `{{guild}}`.",
                listEmpty: "> *None*",
                guildListHeader: "**Blocked guilds:** {{count}}",
                pluginListHeader: "**Blocked plugin rows:** {{count}}"
            }
        }
    },
    errors: {
        unauthorized: "%%emoji_no_entry%% Authentication required.",
        forbidden: "%%emoji_no_entry%% You do not have permission to perform this action.",
        sessionExpired: "%%emoji_clock%% Your session has expired. Please sign in again.",
        rotationDetected: "%%emoji_shield%% Session invalidated for security reasons. Please sign in again."
    }
}
