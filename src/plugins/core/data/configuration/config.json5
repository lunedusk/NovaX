{
    enabled: true,
    status: "online",
    updateIntervalSeconds: 60,
    placeholders: {},
    activities: [
        {
            name: "Server",
            type: "WATCHING",
        },
    ],
    help: {
        filterByPermissions: true,
        maxCharsPerPage: 3000,
        ephemeral: true,
    },
    dataBackend: {
        engine: "sqlite",
        alias: "main",
    },
    guildGate: {
        enabled: true,
    },
    guildAccess: {
        enabled: true,
        conflictPriority: "blacklist",
        emptyWhitelistMeans: "allow_all",
        leaveOnBoot: true,
        leaveOnJoin: true,
        allowOwner: true,
        leaveReason: "Guild is not allowed by bot access policy.",
    },
    guildLocale: {
        enabled: true,
    },
    guildLangFiles: {
        enabled: true,
    },
}
