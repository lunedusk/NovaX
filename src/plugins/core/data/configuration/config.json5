{
    // Master switch for the core addon.
    enabled: true,

    // Presence status: "online" | "idle" | "dnd" | "invisible".
    status: "online",

    // Presence/activity rotation refresh interval, in seconds.
    updateIntervalSeconds: 60,

    // Custom placeholder map. Keys become %%placeholder_key%% substitutions.
    placeholders: {},

    // Rotating presence activities. type: PLAYING | STREAMING | LISTENING | WATCHING | COMPETING.
    activities: [
        {
            name: "Server",
            type: "WATCHING",
        },
    ],

    // /help command behaviour.
    help: {
        filterByPermissions: true,   // Only list commands the invoking user can run.
        maxCharsPerPage: 3000,       // Max characters per help page before pagination.
        ephemeral: true,             // Whether /help replies are ephemeral.
    },
}
