{
    // Master switch for the core addon (presence etc.).
    enabled: true,
    // Presence status: "online" | "idle" | "dnd" | "invisible".
    status: "online",
    updateIntervalSeconds: 60,
    placeholders: {},
    activities: [
        {
            name: "Server",
            type: "WATCHING",
        },
    ],
    help: {
        filterByPermissions: true,
        maxCharsPerPage: 3000,
        ephemeral: true,
    },
    /**
     * Guild gate storage backend.
     * engine: "sqlite" | "postgres" | "mongo"
     * alias: Database env alias (must already be connected), default "main"
     * If engine/alias unavailable → falls back to default sqlite "main".
     * If that also fails → core plugin disables itself in onSetup.
     */
    guildGate: {
        engine: "sqlite",
        alias: "main",
    },
}
