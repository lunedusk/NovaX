namespace NovaX.System;

table FileEntry {
  path: string (key);
  hash: [ubyte];
  size: uint;
}

table IntegrityPayload {
  timestamp: ulong;
  algorithm: string;
  files: [FileEntry];
}

table NovaXManifest {
  id: string;
  name: string;
  version: string;
  description: string;
  author: string;
  dependencies: [string];
  novax_version: string;
  node_version: string;
  priority: int = 0;
  integrity: IntegrityPayload;
}

root_type NovaXManifest;