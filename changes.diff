+        listDescription: nonEmpty,
+        getDescription: nonEmpty,
+        idDescription: nonEmpty,
+        limitDescription: nonEmpty,
+        actorDescription: nonEmpty,
+        actionDescription: nonEmpty,
+        outcomeDescription: nonEmpty,
