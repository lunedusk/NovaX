-<pre><code class="typescript"><span class="hl-10">import</span><span class="hl-0"> { </span><span class="hl-2">BaseRoute</span><span class="hl-0"> } </span><span class="hl-10">from</span><span class="hl-0"> </span><span class="hl-7">&#39;#core/bases/Route.js&#39;</span><span class="hl-0">;</span><br/><span class="hl-10">import</span><span class="hl-0"> </span><span class="hl-10">type</span><span class="hl-0"> { </span><span class="hl-2">Request</span><span class="hl-0">, </span><span class="hl-10">type</span><span class="hl-0"> </span><span class="hl-2">Response</span><span class="hl-0"> } </span><span class="hl-10">from</span><span class="hl-0"> </span><span class="hl-7">&#39;express&#39;</span><span class="hl-0">;</span><br/><br/><span class="hl-10">export</span><span class="hl-0"> </span><span class="hl-10">default</span><span class="hl-0"> </span><span class="hl-8">class</span><span class="hl-0"> </span><span class="hl-5">MetricCollectorEndpoint</span><span class="hl-0"> </span><span class="hl-8">extends</span><span class="hl-0"> </span><span class="hl-5">BaseRoute</span><span class="hl-0"> {</span><br/><span class="hl-0">    </span><span class="hl-8">public</span><span class="hl-0"> </span><span class="hl-8">readonly</span><span class="hl-0"> </span><span class="hl-2">basePath</span><span class="hl-0"> = </span><span class="hl-7">&#39;/metrics/ingest&#39;</span><span class="hl-0">; </span><span class="hl-6">// Mounted path namespace prefix</span><br/><br/><span class="hl-0">    </span><span class="hl-8">protected</span><span class="hl-0"> </span><span class="hl-3">register</span><span class="hl-0">(): </span><span class="hl-5">void</span><span class="hl-0"> {</span><br/><span class="hl-0">        </span><span class="hl-6">// Wrap async route blocks inside an execution handler to catch thread drops</span><br/><span class="hl-0">        </span><span class="hl-8">this</span><span class="hl-0">.</span><span class="hl-2">router</span><span class="hl-0">.</span><spa