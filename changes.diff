+    if (
+        plan.filesToOverwrite.length === 0 &&
+        plan.filesToAdd.length === 0 &&
+        plan.pluginDecisions.some(d => d.action === 'update' || d.action === 'add')
+    ) {
+        return 'plugin-only';
+    }
+    if (plan.toTag || plan.allowed) return 'update';
