+            try {
+                const body = await this.gh.getFileText(owner, repo, pluginsTxtRef, 'plugins.txt');
+                if (body) {
+                    officialLines = parsePluginsTxt(body);
+                    pluginsTxtSource = `tag:${pluginsTxtRef}`;
