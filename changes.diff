+function isPluginPath(rel: string): boolean {
+    const n = rel.replace(/\\/g, '/');
+    return n.startsWith('src/plugins/') || n.startsWith('plugins/');
+}
+
+function pluginRoot(rel: string): string | null {
+    const n = rel.replace(/\\/g, '/');
+    const m = n.match(/^(src\/plugins\/[^/]+|plugins\/[^/]+)/);
+    return m ? m[1] : null;
