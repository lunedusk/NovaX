+                n++;
+            }
+        }
+        const redis = this.redis();
+        if (redis) {
+            try {
+                let cursor = '0';
+                do {
+                    const [next, keys] = await redis.scan(cursor, 'MATCH', 'permcache_*', 'COUNT', 100);
+                    cursor = next;
