+const SENSITIVE_KEY_PATTERN = /(pass(word|code)?|token|secret|api[-_ ]?key|authorization|auth|cookie|session|credential|bearer|private[-_ ]?key|refresh[-_ ]?token|access[-_ ]?token|client[-_ ]?secret)/i;
