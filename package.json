{
  "name": "@novacore-dev/novax",
  "version": "0.1.3",
  "description": "The most versatile modular discord framework for Node.js (discord.js) in TypeScript",
  "main": "./index.js",
  "type": "module",
  "imports": {
    "#core/*": "./core/*",
    "#plugins/*": "./plugins/*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf core plugins scripts index.js index.d.ts",
    "compile": "tsc",
    "copy-assets": "copyfiles -u 1 \"src/**/*.{json5,json,nvx,png,webp,jpg,jpeg,svg}\" \"src/**/data/**/*\" ./",
    "build": "npm run clean && npm run compile && npm run copy-assets",
    "start": "node --import ./core/dependency/index.mjs ./index.js",
    "pack": "node --import ./core/dependency/index.mjs ./scripts/manifestPacker.js",
    "dev": "tsx --import ./src/core/dependency/index.mts ./src/index.ts",
    "docs": "npm run rmdocs && typedoc",
    "rmdocs": "rm -rf docs",
    "flush": "rm -rf core plugins configuration logs .data scripts index.js index.d.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "better-sqlite3": "^12.8.0",
    "cbor": "^10.0.12",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.2",
    "express": "^5.2.1",
    "fast-redact": "^3.5.0",
    "flatbuffers": "^25.9.23",
    "ioredis": "^5.10.1",
    "json5": "^2.2.3",
    "mongoose": "^9.4.1",
    "mysql2": "^3.12.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.0.3",
    "typeorm": "^0.3.20",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fast-redact": "^3.0.4",
    "@types/flatbuffers": "^2.0.1",
    "@types/json5": "^2.2.0",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.2",
    "@types/winston": "^2.4.4",
    "archiver": "^7.0.1",
    "copyfiles": "^2.4.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.1",
    "typedoc": "^0.28.18",
    "typescript": "^5.3.3"
  }
}
